# Web Super Configuration
HOST=127.0.0.1
PORT=8000

# Google Authentication (Google OAuth 2.0 Client ID)
# Lấy tại: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI Model APIs (Tùy chọn nếu muốn dùng trực tiếp)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Zotero API Integration (Tùy chọn)
# Lấy tại: https://www.zotero.org/settings/keys
ZOTERO_USER_ID=
ZOTERO_API_KEY=
ZOTERO_LIBRARY_TYPE=user

# ── BẢO MẬT TÀI KHOẢN (BẮT BUỘC trên Vercel / máy chủ thật) ──────────────────
# Tạo giá trị ngẫu nhiên:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
# Khóa mã hóa API key người dùng (AES-256). SALT tạo bằng secrets.token_hex(16)
VAULT_MASTER_SECRET=
VAULT_MASTER_SALT=

# Email Quản trị viên (đăng nhập bằng Google), phân tách bằng dấu phẩy
ADMIN_EMAILS=
# Nút "Admin 1-click" chỉ hoạt động khi chạy trên localhost; đặt 0 để tắt hẳn
ALLOW_LOCAL_ADMIN_LOGIN=1
# Đăng nhập nhanh dạng Khách: bật/tắt và gói mặc định (free | standard | pro)
QUICK_LOGIN_ENABLED=1
QUICK_LOGIN_PLAN=free

# Đăng nhập Zotero qua trình duyệt (OAuth). Đăng ký ứng dụng tại https://www.zotero.org/oauth/apps
# Callback URL: https://<ten-mien-cua-ban>/api/zotero/oauth/callback
# Bỏ trống thì người dùng vẫn đăng nhập được bằng API key Zotero.
ZOTERO_OAUTH_CLIENT_KEY=
ZOTERO_OAUTH_CLIENT_SECRET=
